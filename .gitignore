.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# ==========================================
# KEEP THESE FILES - PROJECT STRUCTURE
# ==========================================

# Force include important project files (override above patterns)
!data/README.md
!data/raw/README.md
!data/processed/README.md
!data/external/README.md
!data/interim/README.md

# Keep small sample datasets for testing
!data/external/sample_*.csv
!data/raw/sample_*.csv
# Permitir todos os CSVs
#!data/**/*.csv

# Keep documentation and configuration
!docs/
!config/
!src/
!tests/
!scripts/

# Keep project structure files
!requirements.txt
!environment.yml
!setup.py
!pyproject.toml
!README.md
!LICENSE
!CONTRIBUTING.md

# Keep analysis notebooks (but not their outputs)
!notebooks/*.ipynb

# Keep source code
!src/**/*.py
!tests/**/*.py
!scripts/**/*.py

# Keep configuration files
!config/*.yaml
!config/*.yml
!config/*.json
!config/*.ini

# Keep documentation
!docs/**/*.md
!docs/**/*.rst