# Data folders - keep structure but ignore large files
# /data/raw/*.csv  # DESABILITADO - permitir CSVs
/data/raw/*.parquet
# /data/processed/*.csv  # DESABILITADO - permitir CSVs
/data/processed/*.parquet
# /data/interim/*.csv  # DESABILITADO - permitir CSVs
/data/interim/*.parquet

# Keep data structure but ignore large datasets
data/external/*.csv  # DESABILITADO - permitir CSVs
data/external/*.parquet
# data/external/*.xlsx  # DESABILITADO - permitir Excel
data/external/*.json
# data/external/*.txt  # DESABILITADO - permitir TXT
data/external/*.zip
data/external/LI-*

# Ignore text and compressed files
# *.txt  # DESABILITADO - permitir TXT
# *.zip  # DESABILITADO - permitir ZIP

